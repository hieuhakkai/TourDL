<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý Banner Slide</title>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/assets/css/index.css">
  <link rel="stylesheet" href="/assets/css/slideAdmin.css">
  <script src="https://kit.fontawesome.com/7769952fd3.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <div class="nav-bar-content" style="display: flex;">
    <%- include('./menuBar.ejs') %>

    <div class="slide__admin">
      <!-- Overview stats -->
      <%
        const totalSlides = slides.length;
        const activeSlides = slides.filter(s => s.status === 1).length;
        const inactiveSlides = totalSlides - activeSlides;
      %>
      <div class="slide__admin--overview">
        <div class="slide__admin--report">
          <div class="slide__report--header">
            <div class="slide__report--title">Tổng số slide</div>
            <div class="slide__report--icon">
              <i class="fa-solid fa-images"></i>
            </div>
          </div>
          <div class="slide__report--value"><%= totalSlides %></div>
        </div>

        <div class="slide__admin--report active-card">
          <div class="slide__report--header">
            <div class="slide__report--title">Đang hiển thị</div>
            <div class="slide__report--icon icon-green">
              <i class="fa-solid fa-eye"></i>
            </div>
          </div>
          <div class="slide__report--value"><%= activeSlides %></div>
        </div>

        <div class="slide__admin--report inactive-card">
          <div class="slide__report--header">
            <div class="slide__report--title">Đang tạm ẩn</div>
            <div class="slide__report--icon icon-gray">
              <i class="fa-solid fa-eye-slash"></i>
            </div>
          </div>
          <div class="slide__report--value"><%= inactiveSlides %></div>
        </div>
      </div>

      <!-- Function bar -->
      <div class="slide__admin--function">
        <div class="slide__search--box">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="slideSearchInput" class="slide__search--input" placeholder="Tìm kiếm theo tiêu đề slide...">
        </div>
        <div>
          <a href="/admin/slides/add" class="slide__action--add-btn">
            <i class="fa-solid fa-plus"></i> Thêm mới slide
          </a>
        </div>
      </div>

      <!-- Table of slides -->
      <div class="slide__table--card">
        <table class="slide__table">
          <thead>
            <tr>
              <th style="width: 60px;">ID</th>
              <th style="width: 150px;">Hình ảnh</th>
              <th>Tiêu đề & Mô tả</th>
              <th style="width: 140px;">Nguồn ảnh</th>
              <th style="width: 90px; text-align: center;">Thứ tự</th>
              <th style="width: 130px; text-align: center;">Trạng thái</th>
              <th style="width: 130px; text-align: center;">Thao tác</th>
            </tr>
          </thead>
          <tbody id="slideTableBody">
            <% if (slides && slides.length > 0) { %>
              <% slides.forEach(slide => { %>
                <tr class="slide-row" data-id="<%= slide.id %>" data-title="<%= (slide.title || '').toLowerCase() %>">
                  <td><strong>#<%= slide.id %></strong></td>
                  <td>
                    <div class="slide__thumb--wrapper">
                      <img src="<%= slide.image_url %>" alt="<%= slide.title %>" class="slide__thumb--img" onerror="this.src='/assets/image/logo/logo-header.png'">
                    </div>
                  </td>
                  <td>
                    <div class="slide__info--title"><%= slide.title || '(Không có tiêu đề)' %></div>
                    <div class="slide__info--desc"><%= slide.description || 'Chưa có mô tả' %></div>
                    <% if (slide.link_url) { %>
                      <small style="color: #868e96; display: block; margin-top: 4px;">
                        <i class="fa-solid fa-link"></i> <%= slide.link_url %>
                      </small>
                    <% } %>
                  </td>
                  <td>
                    <% if (slide.image_url.startsWith('http://') || slide.image_url.startsWith('https://')) { %>
                      <span class="badge badge-source-link"><i class="fa-solid fa-globe"></i> Link ngoài</span>
                    <% } else { %>
                      <span class="badge badge-source-file"><i class="fa-solid fa-upload"></i> Tải từ máy</span>
                    <% } %>
                  </td>
                  <td style="text-align: center;">
                    <span style="font-weight: 700; color: #0b5da7;"><%= slide.order_index %></span>
                  </td>
                  <td style="text-align: center;">
                    <% if (slide.status === 1) { %>
                      <span class="badge badge-active">Đang hiện</span>
                    <% } else { %>
                      <span class="badge badge-inactive">Đang ẩn</span>
                    <% } %>
                  </td>
                  <td style="text-align: center;">
                    <div class="slide__actions" style="justify-content: center;">
                      <!-- Toggle active/inactive -->
                      <button class="btn-action btn-toggle <%= slide.status === 1 ? 'active-btn' : '' %>" 
                              title="<%= slide.status === 1 ? 'Bấm để ẩn' : 'Bấm để hiện' %>"
                              onclick="toggleSlide(<%= slide.id %>)">
                        <i class="fa-solid <%= slide.status === 1 ? 'fa-eye' : 'fa-eye-slash' %>"></i>
                      </button>
                      <!-- Edit -->
                      <a href="/admin/slides/modify/<%= slide.id %>" class="btn-action btn-edit" title="Chỉnh sửa">
                        <i class="fa-solid fa-pen-to-square"></i>
                      </a>
                      <!-- Delete -->
                      <button class="btn-action btn-delete" title="Xóa slide" onclick="deleteSlide(<%= slide.id %>)">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: #868e96;">
                  <i class="fa-regular fa-image" style="font-size: 3rem; margin-bottom: 10px; display: block;"></i>
                  Chưa có slide nào được tạo. Hãy bấm "Thêm mới slide" để tạo slide đầu tiên!
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%- include('../partials/baseScript') %>
  <script src="/js/slideAdmin.js"></script>
</body>
</html>
