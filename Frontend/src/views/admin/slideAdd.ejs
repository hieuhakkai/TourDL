<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thêm mới Banner Slide</title>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/assets/css/index.css">
  <link rel="stylesheet" href="/assets/css/slideAdmin.css">
  <script src="https://kit.fontawesome.com/7769952fd3.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <div class="nav-bar-content" style="display: flex;">
    <%- include('./menuBar.ejs') %>

    <div class="slide__admin">
      <div class="slide__form--container">
        <h2 class="slide__form--title">
          <i class="fa-solid fa-cloud-arrow-up"></i> Thêm Mới Banner Slide
        </h2>

        <form id="addSlideForm">
          <!-- Title -->
          <div class="form-group">
            <label for="slideTitle">Tiêu đề slide <span style="color: red;">*</span></label>
            <input type="text" id="slideTitle" name="title" class="form-control" placeholder="Ví dụ: Khám Phá Vịnh Hạ Long" required>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="slideDesc">Mô tả / Slogan hiển thị trên slide</label>
            <textarea id="slideDesc" name="description" class="form-control" rows="3" placeholder="Nhập câu mô tả thu hút du khách..."></textarea>
          </div>

          <!-- Upload Option Tabs -->
          <div class="form-group">
            <label>Phương thức chọn ảnh <span style="color: red;">*</span></label>
            <div class="upload-type-tabs">
              <div class="upload-tab active" data-type="link">
                <i class="fa-solid fa-link"></i> Dán đường link ảnh (URL)
              </div>
              <div class="upload-tab" data-type="file">
                <i class="fa-solid fa-laptop"></i> Tải ảnh từ máy tính
              </div>
            </div>

            <!-- Pane Link -->
            <div id="paneLink" class="upload-pane active">
              <input type="url" id="slideImageUrl" name="image_url" class="form-control" placeholder="Dán link ảnh (https://...)" autocomplete="off">
              <small style="color: #6c757d; display: block; margin-top: 6px;">
                <i class="fa-solid fa-circle-info"></i> Bạn có thể dán link ảnh chất lượng cao từ Unsplash, Pexels hoặc link ảnh bất kỳ.
              </small>
            </div>

            <!-- Pane File -->
            <div id="paneFile" class="upload-pane">
              <div class="file-dropzone" id="dropzone">
                <i class="fa-solid fa-image"></i>
                <p><strong>Bấm vào đây để chọn ảnh</strong> hoặc kéo thả file ảnh vào đây</p>
                <span>Hỗ trợ JPG, JPEG, PNG, WEBP (Tối đa 15MB)</span>
                <input type="file" id="slideImageFile" name="image_file" accept="image/*" style="display: none;">
              </div>
            </div>

            <!-- Image Live Preview -->
            <div class="preview-box" id="previewBox">
              <img id="previewImg" src="" alt="Xem trước ảnh">
              <button type="button" class="preview-remove-btn" id="removePreviewBtn" title="Hủy ảnh">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          </div>

          <!-- Link URL -->
          <div class="form-group">
            <label for="slideLink">Liên kết khi bấm vào slide (Tùy chọn)</label>
            <input type="text" id="slideLink" name="link_url" class="form-control" placeholder="Mặc định: / (hoặc đường dẫn tour)">
          </div>

          <!-- Order Index & Status -->
          <div style="display: flex; gap: 20px;">
            <div class="form-group" style="flex: 1;">
              <label for="slideOrder">Thứ tự ưu tiên hiển thị</label>
              <input type="number" id="slideOrder" name="order_index" class="form-control" value="0" min="0">
              <small style="color: #868e96;">Số nhỏ hơn sẽ hiển thị trước</small>
            </div>

            <div class="form-group" style="flex: 1;">
              <label for="slideStatus">Trạng thái hiển thị</label>
              <select id="slideStatus" name="status" class="form-control">
                <option value="1" selected>Hiển thị (Active)</option>
                <option value="0">Tạm ẩn (Inactive)</option>
              </select>
            </div>
          </div>

          <!-- Action buttons -->
          <div class="form-buttons">
            <a href="/admin/slides" class="btn-cancel">Hủy bỏ</a>
            <button type="submit" class="btn-submit" id="submitBtn">
              <i class="fa-solid fa-floppy-disk"></i> Lưu Slide
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <%- include('../partials/baseScript') %>
  <script src="/js/slideAdd.js"></script>
</body>
</html>
