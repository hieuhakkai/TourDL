<!-- Link CSS Chân Trang Footer - Phong cách Vietravel Sáng & Hiện Đại -->
<link rel="stylesheet" href="/assets/css/footer.css" />

<footer class="site-footer">
  <div class="grid wide">
    <!-- 1. Logo & Khẩu hiệu thương hiệu trên cùng -->
    <div class="footer-top-brand">
      <a href="/" class="footer-brand-logo-link" title="3TV Travel - Về trang chủ">
        <img
          src="/assets/image/logo/logo-header.png"
          alt="3TV Travel Logo"
          onerror="this.src='/assets/image/logo/travelling.png'"
        />
      </a>
      <div class="footer-brand-slogan">YOUR JOURNEY - YOUR VALUE</div>
    </div>

    <!-- 2. Bốn cột nội dung chính -->
    <div class="row">
      <!-- Cột 1: Thông tin công ty & Liên hệ -->
      <div class="col l-3 m-6 c-12">
        <div class="footer-col">
          <h3 class="footer-company-name">Công ty Cổ phần Du Lịch 3TV Travel</h3>
          
          <div class="footer-info-item">
            <i class="fa-solid fa-location-dot"></i>
            <span>190 Pasteur, Phường Võ Thị Sáu, Quận 3, TP.HCM</span>
          </div>

          <div class="footer-info-item">
            <i class="fa-regular fa-envelope"></i>
            <a href="mailto:info@3tvtravel.vn">info@3tvtravel.vn</a>
          </div>

          <!-- Mạng xã hội -->
          <div class="footer-social-wrapper">
            <div class="footer-social-label">
              <i class="fa-solid fa-globe"></i>
              <span>Theo dõi chúng tôi trên:</span>
            </div>
            <div class="footer-social-icons">
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer-social-icon instagram" title="Instagram">
                <i class="fa-brands fa-instagram"></i>
              </a>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="footer-social-icon facebook" title="Facebook">
                <i class="fa-brands fa-facebook-f"></i>
              </a>
              <a href="https://whatsapp.com" target="_blank" rel="noopener noreferrer" class="footer-social-icon whatsapp" title="WhatsApp">
                <i class="fa-brands fa-whatsapp"></i>
              </a>
              <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" class="footer-social-icon tiktok" title="TikTok">
                <i class="fa-brands fa-tiktok"></i>
              </a>
              <a href="https://m.me" target="_blank" rel="noopener noreferrer" class="footer-social-icon messenger" title="Messenger">
                <i class="fa-brands fa-facebook-messenger"></i>
              </a>
            </div>
          </div>

          <!-- Nút Hotline Gọi Miễn Phí (Pill đỏ) -->
          <div class="footer-hotline-container">
            <a href="tel:19006868" class="footer-hotline-btn" title="Gọi tổng đài">
              <i class="fa-solid fa-phone"></i>
              <span>1900 6868</span>
            </a>
            <span class="footer-hotline-note">Tổng đài miễn phí 24/7</span>
          </div>
        </div>
      </div>

      <!-- Cột 2: THÔNG TIN -->
      <div class="col l-3 m-6 c-12">
        <div class="footer-col">
          <h4 class="footer-col-heading">THÔNG TIN</h4>
          <ul class="footer-nav-list">
            <li class="footer-nav-item">
              <a href="/" class="footer-nav-link">Về chúng tôi</a>
            </li>
            <li class="footer-nav-item">
              <a href="/#tours-section" class="footer-nav-link">Khảo sát tỷ lệ đạt visa</a>
            </li>
            <li class="footer-nav-item">
              <a href="/#tours-section" class="footer-nav-link">Tạp chí du lịch</a>
            </li>
            <li class="footer-nav-item">
              <a href="/#tours-section" class="footer-nav-link">Tin tức & Cẩm nang</a>
            </li>
            <li class="footer-nav-item">
              <a href="/my-orders" class="footer-nav-link">Tra cứu tour đã đặt</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Sitemap</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Trợ giúp & FAQ</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Cột 3: ĐIỀU KIỆN - ĐIỀU KHOẢN -->
      <div class="col l-3 m-6 c-12">
        <div class="footer-col">
          <h4 class="footer-col-heading">ĐIỀU KIỆN - ĐIỀU KHOẢN</h4>
          <ul class="footer-nav-list">
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Chính sách riêng tư</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Thỏa thuận sử dụng</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Chính sách bảo vệ dữ liệu cá nhân</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Quy định hoàn hủy & đổi tour</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Chính sách thanh toán an toàn</a>
            </li>
            <li class="footer-nav-item">
              <a href="javascript:void(0)" class="footer-nav-link">Bảo hiểm du lịch quốc tế</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Cột 4: CHỨNG NHẬN & CHẤP NHẬN THANH TOÁN -->
      <div class="col l-3 m-6 c-12">
        <div class="footer-col">
          <!-- 1. Chứng nhận -->
          <div class="footer-cert-section">
            <h4 class="footer-col-heading">CHỨNG NHẬN</h4>
            <div class="footer-cert-badges">
              <a href="http://online.gov.vn" target="_blank" rel="noopener noreferrer" title="Đã thông báo Bộ Công Thương">
                <img src="/assets/image/footer/bocongthuong.svg" alt="Đã thông báo Bộ Công Thương" class="footer-cert-img" />
              </a>
              <a href="https://www.dmca.com" target="_blank" rel="noopener noreferrer" title="DMCA Protected">
                <img src="/assets/image/footer/dmca.svg" alt="DMCA Protected" class="footer-cert-img" />
              </a>
            </div>
          </div>

          <!-- 2. Chấp nhận thanh toán -->
          <div class="footer-payment-section">
            <h4 class="footer-col-heading">CHẤP NHẬN THANH TOÁN</h4>
            <div class="footer-payment-grid">
              <!-- Hàng 1 -->
              <div class="payment-card" title="Thanh toán qua thẻ VISA">
                <span class="pay-logo-visa">VISA</span>
              </div>
              <div class="payment-card" title="Verified by VISA">
                <span class="pay-logo-verified">Verified by<br/><strong>VISA</strong></span>
              </div>
              <div class="payment-card" title="Thanh toán qua MasterCard">
                <span class="pay-logo-mastercard">
                  <span class="pay-circle-red"></span>
                  <span class="pay-circle-yellow"></span>
                </span>
              </div>
              <div class="payment-card" title="Cổng thanh toán VNPAY">
                <span class="pay-logo-vnpay">
                  <span class="vn">VN</span><span class="pay">PAY</span>
                </span>
              </div>

              <!-- Hàng 2 -->
              <div class="payment-card" title="Thẻ quốc tế JCB">
                <span class="pay-logo-jcb">JCB</span>
              </div>
              <div class="payment-card" title="Ví điện tử ZaloPay">
                <span class="pay-logo-zalopay">
                  <span class="zalo">Zalo</span><span class="pay">Pay</span>
                </span>
              </div>
              <div class="payment-card" title="Thẻ American Express">
                <span class="pay-logo-amex">AMEX</span>
              </div>
              <div class="payment-card" title="Ví MoMo">
                <span class="pay-logo-momo">MoMo</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Dòng bản quyền cuối trang -->
  <div class="footer-bottom-bar">
    <div class="grid wide">
      <p class="footer-copyright-text">
        &copy; <span id="footer-year"></span> <strong>3TV Travel</strong>. Bản quyền thuộc về Công ty Cổ phần Du lịch 3TV Travel. Giấy phép kinh doanh lữ hành quốc tế số 79-999/2026/TCDL.
      </p>
    </div>
  </div>
</footer>

<script>
  (function() {
    var yearEl = document.getElementById('footer-year');
    if (yearEl) {
      yearEl.textContent = new Date().getFullYear();
    }
  })();
</script>

