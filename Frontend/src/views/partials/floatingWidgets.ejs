<!-- Link CSS Cho Chatbox & Nút Lên Đầu Trang -->
<link rel="stylesheet" href="/assets/css/chatbox.css" />

<!-- 1. NÚT DI CHUYỂN LÊN ĐẦU TRANG (MÉP DƯỚI BÊN TRÁI) -->
<div class="button-top" id="btn-back-to-top" title="Cuộn lên đầu trang" aria-label="Cuộn lên đầu trang">
  <div class="button-top__item">
    <i class="fa-solid fa-chevron-up"></i>
  </div>
</div>

<!-- 2. TÍNH NĂNG CHATBOX (MÉP DƯỚI BÊN PHẢI) -->
<div class="tour-chatbox-widget" id="tour-chatbox-widget">
  <!-- Khi di chuột (hover) vào chatbox sẽ hiển thị popup 3 lựa chọn -->
  <div class="chatbox-popup-menu" id="chatbox-popup-menu">
    <div class="chatbox-popup-header">
      <h4 class="chatbox-header-title">
        <i class="fa-solid fa-headset" style="color: #0b5da7;"></i> Hỗ trợ trực tuyến
      </h4>
      <span class="chatbox-header-status">Online</span>
    </div>

    <ul class="chatbox-options-list">
      <!-- Lựa chọn 1: Liên hệ số điện thoại -->
      <li class="chatbox-option-item">
        <a href="tel:0912345678" class="chatbox-option-link chatbox-option-phone" title="Gọi Hotline tư vấn trực tiếp">
          <div class="chatbox-option-icon">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div class="chatbox-option-content">
            <div class="chatbox-option-name">Gọi Hotline</div>
            <div class="chatbox-option-desc">0912 345 678</div>
          </div>
          <i class="fa-solid fa-chevron-right chatbox-option-action"></i>
        </a>
      </li>

      <!-- Lựa chọn 2: Zalo (sử dụng cùng số điện thoại) -->
      <li class="chatbox-option-item">
        <a href="https://zalo.me/0912345678" target="_blank" rel="noopener noreferrer" class="chatbox-option-link chatbox-option-zalo" title="Chat qua Zalo">
          <div class="chatbox-option-icon">
            <svg viewBox="0 0 48 48" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 4C12.954 4 4 12.954 4 24c0 3.79 1.055 7.336 2.88 10.36L4.5 42.5l8.472-2.31A19.86 19.86 0 0024 44c11.046 0 20-8.954 20-20S35.046 4 24 4z" fill="#0068FF"/>
              <path d="M12 29l7.73-10H12.5V16h10.2v2.8L15 28.8h7.9V32H12v-3zm13.5-9.5c0-1.93 1.57-3.5 3.5-3.5s3.5 1.57 3.5 3.5v12h-3v-2.2c-.8 1.4-2.3 2.2-3.8 2.2-2.5 0-4.2-1.8-4.2-4.5 0-2.8 1.9-4.5 4.5-4.5 1.3 0 2.5.6 3.2 1.6V19.5h-3.7v-2.5zm3.5 6.5c-1.4 0-2.3.9-2.3 2.2 0 1.3.9 2.2 2.3 2.2 1.4 0 2.3-.9 2.3-2.2 0-1.3-.9-2.2-2.3-2.2zm9 6h-3V14h3v18z" fill="#FFFFFF"/>
            </svg>
          </div>
          <div class="chatbox-option-content">
            <div class="chatbox-option-name">Chat Zalo</div>
            <div class="chatbox-option-desc">0912 345 678</div>
          </div>
          <i class="fa-solid fa-chevron-right chatbox-option-action"></i>
        </a>
      </li>

      <!-- Lựa chọn 3: Facebook Messenger -->
      <li class="chatbox-option-item">
        <a href="https://m.me/" target="_blank" rel="noopener noreferrer" class="chatbox-option-link chatbox-option-messenger" title="Nhắn tin Facebook Messenger">
          <div class="chatbox-option-icon">
            <i class="fa-brands fa-facebook-messenger"></i>
          </div>
          <div class="chatbox-option-content">
            <div class="chatbox-option-name">Messenger</div>
            <div class="chatbox-option-desc">Tư vấn 24/7</div>
          </div>
          <i class="fa-solid fa-chevron-right chatbox-option-action"></i>
        </a>
      </li>
    </ul>
  </div>

  <!-- Nút Logo Chatbox (Mặc định chỉ hiển thị logo này) -->
  <div class="chatbox-btn-main" id="chatbox-btn-main" title="Hỗ trợ & Tư vấn tour">
    <div class="chatbox-online-status"></div>
    <i class="fa-solid fa-comments chatbox-icon-main"></i>
  </div>
</div>
