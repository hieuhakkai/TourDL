# ==========================================
# TourDL - Root Environment Variables Example
# ==========================================

# Database
MYSQL_PORT=3307
MYSQL_DATABASE=tourdlhdv
MYSQL_USER=tourdl
MYSQL_PASSWORD=tourdlpass
MYSQL_ROOT_PASSWORD=rootpass

# Backend Service (Spring Boot)
SERVER_PORT=8080
JWT_SECRET=tourdl-dev-jwt-secret-key-1234567890
JWT_EXPIRATION=3600000
MAIL_USERNAME=dummy@example.com
MAIL_PASSWORD=dummy-password

# Frontend Web Application (Express.js)
PORT=3124
COOKIE_SIGNED=tourdl-cookie-secret
